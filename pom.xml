<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rot‑POM för multi‑modulprojektet.

  Syfte:
  - Definierar gemensamma versionsparametrar (Java 21, Spring Boot, JUnit) i <properties>.
  - Importerar Spring Boot BOM i <dependencyManagement> så att moduler kan deklarera starter‑beroenden
    utan att ange exakta versioner.
  - Listar alla delmoduler (bff, auth-service, user-service, message-service) i <modules>.
  - Hanterar plugin‑versioner centralt i <build>/<pluginManagement>.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>Microservice</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Microservice</name>

    <!-- Gemensamma projektegenskaper -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.2.5</spring-boot.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
    </properties>

    <!-- BOM‑import så att moduler får enhetliga beroendeversioner -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Lista över moduler som byggs tillsammans -->
    <modules>
        <module>bff</module>
        <module>auth-service</module>
        <module>user-service</module>
        <module>message-service</module>
    </modules>

    <build>
        <!-- Central hantering av plugin‑versioner/standardkonfiguration -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <release>${maven.compiler.target}</release>
                    </configuration>
                </plugin>
                
            </plugins>
        </pluginManagement>
    </build>

</project>